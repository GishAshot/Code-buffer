STIM_PROC : process
    begin
        -- ---------------------------------------------------------------------
        -- ЭТАП 0: НАЧАЛЬНЫЙ СБРОС (RST)
        -- ---------------------------------------------------------------------
        rst       <= '0';
        start     <= '0';
        data_rdy  <= '0';
        adc_busy  <= '0';
        adc_dat   <= (others => '0');
        chan      <= (others => '0');
        dev       <= (others => '0');
        wait for 40 ns;
        rst       <= '1';
        wait for 40 ns;

        -- =====================================================================
        -- КАДР №1: ЗАГОНЯЕМ ПЕРВУЮ ПАЧКУ ДАННЫХ (Маленькие числа 0x1000 + i)
        -- =====================================================================
        adc_busy <= '1'; -- АЦП пошел работать
        wait for 30 ns;

        for i in 0 to 12 loop
            -- Данные 1-го кадра:
            adc_dat <= std_logic_vector(to_unsigned(16#1000# + i * 16#0100#, 16));
            
            if i <= 6 then
                dev  <= "00";
                chan <= std_logic_vector(to_unsigned(i, 4));
            else
                dev  <= "01";
                chan <= std_logic_vector(to_unsigned(i - 7, 4));
            end if;

            data_rdy <= '1';
            wait for 10 ns;
            data_rdy <= '0';
            wait for 30 ns;
        end loop;

        adc_busy <= '0'; -- АЦП закончил 1-й круг!
        wait for 50 ns;

        -- ЗАПРАШИВАЕМ ПЕРВЫЙ ПАКЕТ НАРУЖУ:
        start <= '1';
        wait for 10 ns;
        start <= '0';

        -- Ждем, пока 1-й пакет полностью вылетит в AXI (до флага EOP):
        wait until eop = '1';
        wait for 100 ns; -- небольшая пауза между кадрами

        -- =====================================================================
        -- КАДР №2: ЗАГОНЯЕМ ВТОРУЮ ПАЧКУ ДАННЫХ (СОВЕРШЕННО ДРУГИЕ ЧИСЛА 0x8000 + i)
        -- =====================================================================
        adc_busy <= '1'; -- АЦП пошел на второй круг!
        wait for 30 ns;

        for i in 0 to 12 loop
            -- Данные 2-го кадра (новые!):
            adc_dat <= std_logic_vector(to_unsigned(16#8000# + i * 16#0100#, 16));
            
            if i <= 6 then
                dev  <= "00";
                chan <= std_logic_vector(to_unsigned(i, 4));
            else
                dev  <= "01";
                chan <= std_logic_vector(to_unsigned(i - 7, 4));
            end if;

            data_rdy <= '1';
            wait for 10 ns;
            data_rdy <= '0';
            wait for 30 ns;
        end loop;

        adc_busy <= '0'; -- АЦП закончил 2-й круг!
        wait for 50 ns;

        -- ЗАПРАШИВАЕМ ВТОРОЙ ПАКЕТ НАРУЖУ:
        start <= '1';
        wait for 10 ns;
        start <= '0';

        -- Ждем окончания второго пакета:
        wait until eop = '1';
        wait for 200 ns;

        -- =====================================================================
        -- ФИНИШ ВСЕХ ТЕСТОВ
        -- =====================================================================
        wait;
    end process;
