-- =========================================================================
    -- АВТОНОМНЫЙ ИМИТАТОР ДРАЙВЕРА АЦП (С меняющимися числами от круга к кругу)
    -- =========================================================================
    MOCK_ADC_DRIVER : process
        -- Счетчик кругов (кадров):
        variable round_cnt : integer := 1;
        variable base_val  : integer := 0;
    begin
        -- Сигналы в покое:
        adc_busy <= '0';
        data_rdy <= '0';
        adc_dat  <= (others => '0');

        -- 1. ЖДЕМ команды запуска от вашего блока (или сигнала сброса):
        wait until rising_edge(clk) and start_adc = '1';

        -- 2. АЦП просыпается, поднимаем BUSY:
        adc_busy <= '1';
        wait for 40 ns;

        -- 3. Вычисляем базу для текущего круга (чтобы числа чередовались!):
        -- Круг 1: база 0x1000
        -- Круг 2: база 0x5000
        -- Круг 3: база 0x9000 ... числа всегда разные!
        base_val := round_cnt * 16#2000#;

        -- 4. Выдаем пачку из 13 каналов:
        for i in 0 to 12 loop

            -- Замер: База круга + смещение датчика (наглядно видно и чип, и круг!):
            adc_dat <= std_logic_vector(to_unsigned(base_val + (i * 16#0100#), 16));

            -- Раскладка по чипам и ножкам:
            if i <= 6 then
                dev  <= "00"; -- АЦП 1
                chan <= std_logic_vector(to_unsigned(i, 4));
            else
                dev  <= "01"; -- АЦП 2
                chan <= std_logic_vector(to_unsigned(i - 7, 4));
            end if;

            -- Строб готовности на 1 такт (10 нс):
            data_rdy <= '1';
            wait for 10 ns;
            data_rdy <= '0';

            -- Пауза между замерами:
            wait for 30 ns;
        end loop;

        -- 5. Все 13 каналов выданы — опускаем BUSY:
        adc_busy  <= '0';
        round_cnt := round_cnt + 1; -- на следующем круге числа будут ДРУГИМИ!

        wait for 50 ns;
    end process;